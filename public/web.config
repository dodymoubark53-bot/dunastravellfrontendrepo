<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <rewrite>
      <rules>
        <!-- 1. 301 Permanent Redirects for Old Site Home Language Variants -->
        <rule name="Redirect Legacy index-Spa" stopProcessing="true">
          <match url="^index-Spa\.html$" ignoreCase="true" />
          <action type="Redirect" url="/?lang=es" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy index-Por" stopProcessing="true">
          <match url="^index-Por\.html$" ignoreCase="true" />
          <action type="Redirect" url="/?lang=pt" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy index-Ita" stopProcessing="true">
          <match url="^index-Ita\.html$" ignoreCase="true" />
          <action type="Redirect" url="/?lang=it" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy index-Arb" stopProcessing="true">
          <match url="^index-Arb\.html$" ignoreCase="true" />
          <action type="Redirect" url="/?lang=ar" redirectType="Permanent" />
        </rule>

        <!-- 2. 301 Permanent Redirects for Old Static HTML Pages -->
        <rule name="Redirect Legacy About" stopProcessing="true">
          <match url="^about(-[a-zA-Z]+)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/about" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Contact" stopProcessing="true">
          <match url="^contact(-[a-zA-Z]+)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/contact" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Hotels" stopProcessing="true">
          <match url="^hotels(-[a-zA-Z]+)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/hotels" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Gallery" stopProcessing="true">
          <match url="^gallery(-[a-zA-Z]+)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/gallery" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Cruises and Tours" stopProcessing="true">
          <match url="^(cruises|jordan|cleopatra|ramsesii|nefertaria|nefertarib|nefertiti|akhenaton|amon|hathor|hatshpsut|amenhoteb|zoser)(-.*)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/tours" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Services" stopProcessing="true">
          <match url="^(services|pricing)\.html$" ignoreCase="true" />
          <action type="Redirect" url="/services" redirectType="Permanent" />
        </rule>

        <!-- 3. SPA Fallback Routing for Modern Application -->
        <rule name="SPA Fallback Routing" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".env.production" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Cross-Origin-Opener-Policy" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin-allow-popups" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self' https://api.dunas-travel.com; script-src 'self' 'unsafe-inline' https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://res.cloudinary.com https://images.unsplash.com https://img.youtube.com https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://cdnjs.cloudflare.com https://static.arrajol.com https://www.touristsecrets.com; connect-src 'self' https://api.dunas-travel.com https://res.cloudinary.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; media-src 'self' blob: https://res.cloudinary.com; object-src 'none'; base-uri 'self';" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".vtt" />
      <mimeMap fileExtension=".vtt" mimeType="text/vtt" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>

  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="fonts">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="imgs">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
